{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node tools/hud.js public/hud.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/game"
    },
    {
      "source": "/ws",
      "destination": "/api/ws"
    },
    {
      "source": "/info",
      "destination": "/api/info"
    },
    {
      "source": "/qr.svg",
      "destination": "/api/qr"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|wasm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/ws.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "look-ahead-radar.vercel.app"
        }
      ],
      "destination": "https://rm-racing.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "look-ahead-radar-pilot123321s-projects.vercel.app"
        }
      ],
      "destination": "https://rm-racing.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "look-ahead-radar-git-main-pilot123321s-projects.vercel.app"
        }
      ],
      "destination": "https://rm-racing.vercel.app/:path*",
      "permanent": false
    }
  ]
}
